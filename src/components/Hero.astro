---
import type { Photo } from '../data/photos';

interface Props { photo: Photo }
const { photo } = Astro.props;
---

<section class="hero page-shell">
  <div class="hero-image-wrap">
    <img class="hero-image" src={photo.image} alt={photo.alt} fetchpriority="high" />
    <span class="image-index">01 / Featured</span>
  </div>
  <div class="hero-copy">
    <p class="eyebrow">Atlanta, Georgia</p>
    <h1>Aviation<br />Photography</h1>
    <p class="hero-intro">Commercial aviation, aircraft spotting, and moments from airports around the world.</p>
    <a class="text-link" href="/gallery">View gallery <span aria-hidden="true">↗</span></a>
  </div>
</section>
