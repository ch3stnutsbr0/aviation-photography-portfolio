---
const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Benli Liu Aviation Photography home">
    <span>Benli Liu</span>
    <span>Aviation Photography</span>
  </a>
  <nav aria-label="Main navigation">
    {links.map((link) => (
      <a href={link.href} aria-current={pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href)) ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
</header>
