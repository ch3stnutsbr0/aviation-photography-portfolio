---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RadarSection from '../components/RadarSection.astro';
import { featuredPhoto, photoDetailUrl, photos } from '../data/photos';
---

<BaseLayout>
  <Hero photo={featuredPhoto} />
  <section class="home-selection page-shell">
    <div class="section-heading">
      <p class="eyebrow">Recent photographs</p>
      <a class="text-link" href="/gallery">View archive <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-pair">
      {photos.slice(1, 3).map((photo) => (
        <a href={photoDetailUrl(photo)}>
          <img src={photo.image} alt={photo.alt} loading="lazy" />
          <p>{photo.title} <span>{photo.airport} / {photo.date.slice(0, 4)}</span></p>
        </a>
      ))}
    </div>
  </section>
  <RadarSection />
</BaseLayout>
