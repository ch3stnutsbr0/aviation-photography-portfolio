---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Benli Liu Aviation Photography">
  <section class="about page-shell">
    <p class="eyebrow">About / Benli Liu</p>
    <div class="about-grid">
      <h1>Looking closely at the everyday theater of flight.</h1>
      <div class="about-copy">
        <p>My name is Benli Liu, an aviation photographer and aircraft spotting enthusiast based in Atlanta. I photograph commercial aircraft, unusual visitors, special liveries, and everyday airport operations.</p>
        <p>I am currently a graduate student at Georgia Tech. My interest in aircraft spotting also led me to create Aircraft Spotter Radar, a project designed to help spotters discover interesting aircraft movements.</p>
        <div class="about-links">
          <a class="text-link" href="https://github.com/" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="mailto:hello@example.com">Email <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
